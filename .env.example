# ─────────────────────────────────────────────────────────────────────────────
# Kimwanyi SACCO — Mail Configuration
#
# Copy this file to ".env" (never commit .env) and fill in your values.
# Then export the variables before starting the server or running tests:
#
#   set -a && source .env && set +a
#
# Or pass them as JVM system properties at runtime:
#   -Dmail.smtp.host=smtp.gmail.com
#   -Dmail.smtp.username=you@gmail.com
#   -Dmail.smtp.password=your-app-password
#
# Priority (highest → lowest):
#   1. JVM system property  (-Dkey=value)
#   2. Environment variable (listed below)
#   3. Built-in default
# ─────────────────────────────────────────────────────────────────────────────

# SMTP server hostname
MAIL_SMTP_HOST=smtp.gmail.com

# SMTP port (587 = STARTTLS, 465 = SSL)
MAIL_SMTP_PORT=587

# Enable SMTP authentication  (true | false)
MAIL_SMTP_AUTH=true

# Enable STARTTLS  (true | false)
MAIL_SMTP_STARTTLS=true

# "From" address shown to email recipients
MAIL_FROM=noreply@kimwanyi-sacco.org

# SMTP login credentials
# For Gmail, use an App Password (not your account password):
#   https://myaccount.google.com/apppasswords
MAIL_SMTP_USERNAME=your-email@gmail.com
MAIL_SMTP_PASSWORD=your-app-password
